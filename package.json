{
  "name": "cadastro-interesse-atendimento",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "test": "vitest -c ./vitest.config.unit.mjs",
    "test:unit:ci": "vitest run -c ./vitest.config.unit.mjs --coverage",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "test:int:ci": "vitest run -c ./vitest.config.integration.mjs --coverage",
		"db:push": "prisma db push --schema prisma/postgres/schema.prisma",
		"mongodb:push": "prisma db push --schema prisma/mongodb/schema.prisma",
		"e2e": "cypress open",
		"e2e:ci": "cypress run --browser chrome"
  },
  "dependencies": {
    "@next/third-parties": "^14.2.5",
    "@prisma/client": "6",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "@radix-ui/themes": "^3.1.1",
    "dotenv": "^17.4.2",
    "formik": "^2.4.6",
    "next": "16.2.11",
    "pino": "^9.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-input-mask": "3.0.0-alpha.2",
    "react-select": "^5.8.0",
    "react-toastify": "^10.0.6",
    "reactjs-popup": "^2.0.6",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-input-mask": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "cypress": "^15.20.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.1",
    "prisma": "6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
